{
  "title": "Yomu Forum - Overview",
  "panels": [
    {
      "type": "graph",
      "title": "JVM Memory Used (bytes)",
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "heap"
        }
      ]
    },
    {
      "type": "graph",
      "title": "HTTP Request Rate (ops/sec)",
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count[1m])",
          "legendFormat": "{{uri}} {{status}}"
        }
      ]
    },
    {
      "type": "graph",
      "title": "HTTP Error Rate (5xx ops/sec)",
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])",
          "legendFormat": "{{uri}} {{status}}"
        }
      ]
    },
    {
      "type": "graph",
      "title": "JVM Threads",
      "targets": [
        {
          "expr": "jvm_threads_live_threads",
          "legendFormat": "live"
        },
        {
          "expr": "jvm_threads_daemon_threads",
          "legendFormat": "daemon"
        }
      ]
    },
    {
      "type": "graph",
      "title": "HikariCP Active Connections",
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "Active"
        },
        {
          "expr": "hikaricp_connections_idle",
          "legendFormat": "Idle"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Application Uptime",
      "targets": [
        {
          "expr": "process_uptime_seconds",
          "legendFormat": "Uptime"
        }
      ]
    },
    {
      "type": "graph",
      "title": "JVM GC Pause Time (rate)",
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum[1m])",
          "legendFormat": "GC Pause"
        }
      ]
    },
    {
      "type": "graph",
      "title": "HTTP Response Latency (P95)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95 Latency"
        }
      ]
    }
  ]
}
